---
import Layout from '../layouts/Layout.astro';
import { Header } from '../components/layout/Header';
import { QRStudio } from '../components/qr/QRStudio';
---

<Layout
  title="QR Studio — Soft Neon Astro QR Suite"
  description="Generate, style, frame, logo-brand and decode QR codes with client-side privacy, vector SVG, PDF, and high-res PNG export."
>
  <Header client:load />

  <main class="flex-1 pb-16">
    <QRStudio client:load />
  </main>

  <!-- Clean Neumorphic Footer -->
  <footer class="border-t border-border bg-surface/50 py-8 backdrop-blur-xs">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-text-muted">
      <div class="flex items-center gap-2">
        <span class="font-heading font-semibold text-text-main">QR Studio</span>
        <span>-</span>
        <span>100% Client-Side & Private</span>
      </div>
      <div class="flex items-center gap-4">
        <a
          href="https://github.com/baaaaan1/QR-Studio"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 transition-colors hover:text-primary"
        >
          <svg viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4" aria-hidden="true">
            <path d="M12 .5C5.37.5 0 5.78 0 12.29c0 5.21 3.44 9.63 8.21 11.19.6.11.82-.25.82-.56 0-.28-.01-1.02-.02-2-3.34.71-4.04-1.58-4.04-1.58-.55-1.37-1.34-1.74-1.34-1.74-1.09-.73.08-.72.08-.72 1.21.08 1.84 1.22 1.84 1.22 1.07 1.8 2.81 1.28 3.5.98.11-.76.42-1.28.76-1.58-2.67-.29-5.47-1.31-5.47-5.83 0-1.29.47-2.34 1.24-3.17-.12-.29-.54-1.48.12-3.09 0 0 1.01-.32 3.3 1.21a11.6 11.6 0 0 1 6 0c2.29-1.53 3.3-1.21 3.3-1.21.66 1.61.24 2.8.12 3.09.77.83 1.24 1.88 1.24 3.17 0 4.53-2.81 5.54-5.48 5.83.43.36.81 1.08.81 2.18 0 1.57-.01 2.84-.01 3.23 0 .31.21.67.83.56A12.02 12.02 0 0 0 24 12.29C24 5.78 18.63.5 12 .5z" />
          </svg>
          <span>baaaaan1</span>
        </a>
      </div>
    </div>
  </footer>
</Layout>
