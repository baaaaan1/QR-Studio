---
import Layout from '../layouts/Layout.astro';
import { Header } from '../components/layout/Header';
---

<Layout
  title="404 — Page Not Found | QR Studio"
  description="The page you are looking for does not exist. Head back to QR Studio to generate, style, frame, and decode QR codes."
>
  <Fragment slot="head">
    <meta name="robots" content="noindex" />
  </Fragment>

  <Header client:load />

  <main class="flex flex-1 items-center justify-center px-4 py-16 sm:px-6 lg:px-8">
    <div class="neu-card w-full max-w-md rounded-major p-8 text-center sm:p-10">
      <div class="neu-button mx-auto flex h-16 w-16 items-center justify-center rounded-control">
        <img src="/favicon-light.svg" alt="QR Studio logo" class="h-10 w-10 dark:hidden" draggable={false} />
        <img src="/favicon.svg" alt="" class="hidden h-10 w-10 dark:block" draggable={false} />
      </div>

      <p class="mt-6 font-heading text-5xl font-bold tracking-tight text-primary">404</p>
      <h1 class="mt-3 font-heading text-xl font-semibold text-text-main">Page not found</h1>
      <p class="mt-2 text-sm text-text-muted">
        The page you requested does not exist or has been moved. Check the address, or head back to the studio.
      </p>

      <a
        href="/"
        class="mt-8 inline-flex items-center gap-2 rounded-control bg-primary px-5 py-2.5 text-sm font-semibold text-on-primary shadow-glow-emerald transition-all hover:opacity-90 active:scale-[0.98]"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4" aria-hidden="true">
          <path d="M19 12H5" />
          <path d="m12 19-7-7 7-7" />
        </svg>
        <span>Back to QR Studio</span>
      </a>
    </div>
  </main>
</Layout>
