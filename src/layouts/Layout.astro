---
import AmbientGlow from '../components/layout/AmbientGlow.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'QR Studio — Soft Neon Neumorphic QR Code Suite',
  description = 'High-end QR Code Generator, Frame Designer, Logo Customizer & Decoder with vector SVG, PDF, and high-res PNG export.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" id="app-favicon" type="image/svg+xml" href="/favicon-light.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <slot name="head" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Zero-flicker theme initialization -->
    <script is:inline>
      (function () {
        const storedTheme = localStorage.getItem('qr_studio_theme');
        const systemDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const isDark = storedTheme === 'dark' || (!storedTheme && systemDark);
        if (isDark) {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
        const favicon = document.getElementById('app-favicon');
        if (favicon) {
          favicon.setAttribute('href', isDark ? '/favicon.svg' : '/favicon-light.svg');
        }
      })();
    </script>
  </head>
  <body class="relative min-h-screen bg-background text-text-main antialiased selection:bg-primary selection:text-on-primary">
    <AmbientGlow />
    <div class="relative z-10 flex min-h-screen flex-col">
      <slot />
    </div>
  </body>
</html>
