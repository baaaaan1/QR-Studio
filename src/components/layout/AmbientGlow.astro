---
// Fresh Signal ambient glows - emerald + electric blue only, very low opacity
---

<div class="pointer-events-none fixed inset-0 z-0 overflow-hidden select-none">
  <!-- Top Left: Emerald -->
  <div
    class="absolute -top-[15vw] -left-[15vw] w-[45vw] h-[45vw] rounded-full blur-[120px] transition-colors duration-500"
    style="background: radial-gradient(circle, var(--ambient-emerald) 0%, transparent 70%);"
  ></div>

  <!-- Bottom Right: Electric Blue -->
  <div
    class="absolute -bottom-[15vw] -right-[15vw] w-[45vw] h-[45vw] rounded-full blur-[120px] transition-colors duration-500"
    style="background: radial-gradient(circle, var(--ambient-blue) 0%, transparent 70%);"
  ></div>
</div>
