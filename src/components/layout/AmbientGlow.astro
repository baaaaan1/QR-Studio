---
// Soft Neon Astro Ambient Corner Lights (very low opacity, non-distracting)
---

<div class="pointer-events-none fixed inset-0 z-0 overflow-hidden select-none">
  <!-- Top Left: Indigo -->
  <div
    class="absolute -top-[15vw] -left-[15vw] w-[50vw] h-[50vw] rounded-full blur-[120px] transition-colors duration-500"
    style="background: radial-gradient(circle, var(--ambient-indigo) 0%, transparent 70%);"
  ></div>

  <!-- Top Right: Cyan -->
  <div
    class="absolute -top-[15vw] -right-[15vw] w-[50vw] h-[50vw] rounded-full blur-[120px] transition-colors duration-500"
    style="background: radial-gradient(circle, var(--ambient-cyan) 0%, transparent 70%);"
  ></div>

  <!-- Bottom Left: Pink -->
  <div
    class="absolute -bottom-[15vw] -left-[15vw] w-[45vw] h-[45vw] rounded-full blur-[120px] transition-colors duration-500"
    style="background: radial-gradient(circle, var(--ambient-pink) 0%, transparent 70%);"
  ></div>

  <!-- Bottom Right: Green -->
  <div
    class="absolute -bottom-[15vw] -right-[15vw] w-[45vw] h-[45vw] rounded-full blur-[120px] transition-colors duration-500"
    style="background: radial-gradient(circle, var(--ambient-green) 0%, transparent 70%);"
  ></div>
</div>
